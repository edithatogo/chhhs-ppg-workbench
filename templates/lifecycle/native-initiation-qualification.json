{
  "qualificationOnly": true,
  "realPolicyEffects": false,
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "$authentication": {
        "defaultValue": {},
        "type": "SecureObject"
      },
      "$connections": {
        "defaultValue": {},
        "type": "Object"
      }
    },
    "triggers": {
      "manual": {
        "type": "Request",
        "kind": "Button",
        "inputs": {
          "schema": {
            "type": "object",
            "properties": {},
            "required": []
          }
        },
        "runtimeConfiguration": {
          "concurrency": {
            "runs": 1
          }
        }
      }
    },
    "actions": {
      "Find_case": {
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
            "connectionName": "shared_sharepointonline",
            "operationId": "HttpRequest"
          },
          "parameters": {
            "dataset": "${QUALIFIED_SITE_URL}",
            "parameters/method": "GET",
            "parameters/uri": "_api/web/lists(guid'${PRIVATE_NATIVE_ID}')/items?$filter=CaseUID eq 'LC-FICTIONAL-20261017-01'&$select=Id,CaseUID,linkedDocumentUIDs,sourceBaselineRef,accountableRole,caseStatus,nextAction,Title",
            "parameters/headers": {
              "Accept": "application/json;odata=nometadata"
            }
          }
        },
        "runAfter": {}
      },
      "Create_if_absent": {
        "type": "If",
        "expression": "@equals(length(body('Find_case')?['value']),0)",
        "runAfter": {
          "Find_case": [
            "Succeeded"
          ]
        },
        "actions": {
          "Create_fictional_case": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                "connectionName": "shared_sharepointonline",
                "operationId": "HttpRequest"
              },
              "parameters": {
                "dataset": "${QUALIFIED_SITE_URL}",
                "parameters/method": "POST",
                "parameters/uri": "_api/web/lists(guid'${PRIVATE_NATIVE_ID}')/items",
                "parameters/headers": {
                  "Accept": "application/json;odata=nometadata",
                  "Content-Type": "application/json;odata=nometadata"
                },
                "parameters/body": "{\"Title\": \"FICTIONAL lifecycle qualification \\u2014 initiation only\", \"CaseUID\": \"LC-FICTIONAL-20261017-01\", \"linkedDocumentUIDs\": \"[\\\"FICTIONAL-DOC-LC-20261017-01\\\"]\", \"sourceBaselineRef\": \"fictional://ppg-lifecycle/20261017/occurrence-01\", \"accountableRole\": \"Unaccepted \\u2014 FICTIONAL only\", \"proposedOutcome\": \"FICTIONAL workflow qualification; no real policy outcome\", \"nextAction\": \"Record an explicit fictional ownership proposal and acceptance\", \"caseStatus\": \"Initiated \\u2014 FICTIONAL\"}"
              }
            },
            "runAfter": {}
          }
        },
        "else": {
          "actions": {}
        }
      },
      "Readback_case": {
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
            "connectionName": "shared_sharepointonline",
            "operationId": "HttpRequest"
          },
          "parameters": {
            "dataset": "${QUALIFIED_SITE_URL}",
            "parameters/method": "GET",
            "parameters/uri": "_api/web/lists(guid'${PRIVATE_NATIVE_ID}')/items?$filter=CaseUID eq 'LC-FICTIONAL-20261017-01'&$select=Id,CaseUID,linkedDocumentUIDs,sourceBaselineRef,accountableRole,caseStatus,nextAction,Title",
            "parameters/headers": {
              "Accept": "application/json;odata=nometadata"
            }
          }
        },
        "runAfter": {
          "Create_if_absent": [
            "Succeeded"
          ]
        }
      },
      "Verify_initiation": {
        "type": "If",
        "expression": "@and(equals(length(body('Readback_case')?['value']),1),equals(first(body('Readback_case')?['value'])?['sourceBaselineRef'],'fictional://ppg-lifecycle/20261017/occurrence-01'),equals(first(body('Readback_case')?['value'])?['linkedDocumentUIDs'],'[\"FICTIONAL-DOC-LC-20261017-01\"]'),equals(first(body('Readback_case')?['value'])?['caseStatus'],'Initiated \u2014 FICTIONAL'))",
        "runAfter": {
          "Readback_case": [
            "Succeeded"
          ]
        },
        "actions": {
          "Native_receipt": {
            "type": "Compose",
            "inputs": {
              "requestId": "LC-INIT-20261017-01",
              "CaseUID": "LC-FICTIONAL-20261017-01",
              "occurrence": "fictional://ppg-lifecycle/20261017/occurrence-01",
              "DocumentUID": "FICTIONAL-DOC-LC-20261017-01",
              "operation": "initiate",
              "caseItemId": "@first(body('Readback_case')?['value'])?['Id']",
              "result": "verified-fictional-initiation",
              "createdCount": "@if(equals(length(body('Find_case')?['value']),0),1,0)",
              "runId": "@workflow()?['run']?['name']",
              "asOfUtc": "@utcNow()",
              "realPolicyEffects": false
            },
            "runAfter": {}
          }
        },
        "else": {
          "actions": {
            "Refuse": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "CasePinMismatch",
                  "message": "Duplicate or changed fictional case; no advancement"
                }
              },
              "runAfter": {}
            }
          }
        }
      }
    },
    "outputs": {}
  }
}
