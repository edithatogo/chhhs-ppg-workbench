flowchart TD
  start["Authorised package preparation"]
  start --> n0["Select recorded metadata"]
  n0 --> n1["Populate draft template"]
  n1 --> n2["Retain source and output revision"]
  n2 --> n3["Open and edit draft"]
  n3 --> n4["Record missing review inputs"]
  n4 --> n5["For review intelligence verify source and template before substantive comparison"]
  n5 --> n6["Account for every catalogue item and preserve unmapped content"]
  n6 --> n7["Carry unresolved annotations with full retained history and version reconciliation"]
  n7 --> n8["Store a new preparation revision with hash readback; hold missing evidence"]
  n8 --> n9["Inspect historical source content through source/reviewer-separated modules; preserve the original archive and unsupported elements"]
  n9 --> n10["Read provisional passage-backed findings and proposed next actions without promoting historical observations to the requested edition"]
  n10 --> n11["Use the versioned operator supplement to navigate qualified records and evidence"]
  n11 --> n12["Distinguish retained printed identifiers from catalogue assertions; explicit unverified variants never promote current-edition coverage"]
  n12 --> n13["Record document, template-candidate, criteria and draft-prompt versions plus available runtime and unresolved evidence"]
  n13 --> output["Editable unapproved draft package"]
  start -. "Missing, stale or conflicting evidence" .-> hold["Hold affected operation; preserve evidence; reconcile before retry"]
