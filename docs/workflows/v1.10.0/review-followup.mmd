flowchart TD
  start["Operator reviews queue or runs local preview"]
  start --> n0["Inspect action role and date views"]
  n0 --> n1["Append dated local follow-up assertion"]
  n1 --> n2["Validate version ownership recipient and freshness"]
  n2 --> n3["Suppress closed or unresolved candidates"]
  n3 --> n4["Compare unchanged repeated preview"]
  n4 --> n5["Capture version-bound review annotations and retain original wording"]
  n5 --> n6["Carry unresolved suggestions and require reconciliation after section changes"]
  n6 --> n7["Keep evidence, inference, unknowns and human decisions separate"]
  n7 --> n8["Use eight advisory criteria and eleven decision options; vocabulary records are not human decisions"]
  n8 --> n9["Carry all unresolved annotations from complete exports; preserve original contributions and reconcile current document versions and sections"]
  n9 --> output["Private manual digest preview and exceptions"]
  start -. "Missing, stale or conflicting evidence" .-> hold["Hold affected operation; preserve evidence; reconcile before retry"]
