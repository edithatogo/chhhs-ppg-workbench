flowchart TD
  start["Importer holds an unresolved source identity"]
  start --> n0["Inspect alias or new identity candidate"]
  n0 --> n1["Record human accept or reject"]
  n1 --> n2["Prepare guarded application package"]
  n2 --> n3["Apply through sole importer"]
