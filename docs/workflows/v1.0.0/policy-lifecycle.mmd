  n4 --> n5["Record exact-version consultation request and response"]
  n5 --> n6["Check readiness and retain the human finding"]
  n6 --> n7["Record purpose-specific decision evidence"]
  n7 --> n8["Retain fictional publication representation and independent byte proof"]
  n8 --> n9["Record implementation evidence"]
  n9 --> n10["Record independent verification against its selected parent"]
  n10 --> n11["Close the review through the dedicated connected closure operation"]
  n11 --> n12["Initiate a separate next review from the closure trace"]
  n12 --> output["Closed fictional occurrence and linked new occurrence"]
